{
  "expo": {
    "name": "Falta uno",
    "slug": "falta-uno",
    "scheme": "falta-uno",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.faltauno.app"
    },
    "android": { "package": "com.faltauno.app" },
    "plugins": ["expo-router", "expo-secure-store"],
    "web": { "bundler": "metro", "output": "single" }
  }
}
